{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ptcg/common": ["./src/lib/ptcg-engine/index.ts"],
      "@ptcg/common/*": ["./src/lib/ptcg-engine/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/ptcg-engine/**/*.spec.ts",
    "src/lib/ptcg-sets/**/tests/**",
    "src/engine/rules/rule-executor.ts",
    "src/engine/rules/rule-compiler.ts",
    "src/engine/rules/rule-validator.ts",
    "src/engine/rules/rule-loader.ts",
    "src/engine/rules/event-hooks.ts",
    "src/engine/rules/modifier-pipeline.ts",
    "src/engine/llm/offline-rule-generator.ts",
    "src/engine/llm/batch-processor.ts",
    "src/engine/llm/generate-all-rules.ts",
    "src/engine/llm/index.ts",
    "src/__tests__/offline-rule-generator.test.ts",
    "src/__tests__/cta-rule-system.test.ts"
  ]
}
